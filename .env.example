# Copiar a .env.local (ignorado por git) y llenar con los valores reales.
# Ambos son seguros de exponer en el cliente — son la Project URL y la
# publishable/anon key de Supabase (Settings → API en el dashboard).
# NUNCA poner aquí la service_role key ni la contraseña de la base de datos.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
