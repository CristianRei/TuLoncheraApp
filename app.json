{
  "expo": {
    "name": "Tu Lonchera",
    "slug": "tulonchera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tulonchera",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Tu Lonchera usa la cámara para escanear códigos de barras."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tu Lonchera usa tus fotos para ponerle imagen a los productos del catálogo.",
          "cameraPermission": "Tu Lonchera usa la cámara para tomarle foto a los productos del catálogo."
        }
      ],
      "expo-sharing",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tu Lonchera usa tu ubicación para registrar dónde inicias tu turno."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
